{
    "name": "moves/code",
    "description": "Moves Code - Plataforma PHP modular para sites, CMS e aplicativos",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "movescode/router": "^1.3",
        "movescode/middleware": "^0.1",
        "movescode/model": "^1.0",
        "movescode/view": "^1.0",
        "movescode/pager": "^1.0",
        "movescode/seo": "^2.0",
        "movescode/storage": "^1.0",
        "movescode/cropper": "^1.0",
        "movescode/compress": "^1.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "MovesCode\\App\\": "src/",
            "Moves\\Modules\\": "modules/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
