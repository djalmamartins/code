APP_NAME="Moves Code"
APP_ENV=local
APP_DEBUG=false
APP_URL=https://code.lab

# Configure only after creating a dedicated database user with least privilege.
MOVES_DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=moves_code;charset=utf8mb4"
MOVES_DB_USER=
MOVES_DB_PASSWORD=

# Base64 of 32 random bytes; keep the generated value only in the ignored .env file.
MOVES_2FA_ENCRYPTION_KEY=

# Optional SMTP transport. Leave empty until the provider settings are confirmed.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Moves Code"
